{
  "name": "crypto-lab-musig-gate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test --project=a11y --project=flows-desktop --project=flows-mobile",
    "test:e2e": "playwright test --project=flows-desktop --project=flows-mobile",
    "test:axe": "playwright test --project=a11y",
    "test:e2e:all": "playwright test",
    "bench": "vitest bench --run",
    "perf": "npm run build && node scripts/perf.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.0.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.0.1"
  }
}
